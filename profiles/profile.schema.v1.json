{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://minimal-os.invalid/schemas/device-profile-v1.json",
  "title": "Minimal OS exact device profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "profileId", "manufacturer", "model", "sdkInt",
    "vendorVersion", "fingerprint", "packages"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "profileId": { "type": "string", "minLength": 1 },
    "manufacturer": { "type": "string", "minLength": 1 },
    "model": { "type": "string", "minLength": 1 },
    "sdkInt": { "type": "integer", "minimum": 21 },
    "vendorVersion": { "type": "string", "minLength": 1 },
    "fingerprint": { "type": "string", "minLength": 1 },
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "packageName", "classification", "justification", "prerequisites",
          "risk", "method", "restoreStrategy", "source", "validation", "tests"
        ],
        "properties": {
          "packageName": { "type": "string", "minLength": 1 },
          "classification": {
            "enum": ["critical", "protected", "candidate", "unknown"]
          },
          "justification": { "type": "string", "minLength": 1 },
          "prerequisites": { "type": "array", "items": { "type": "string" } },
          "risk": { "type": "string", "minLength": 1 },
          "method": { "type": "string", "minLength": 1 },
          "restoreStrategy": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1 },
          "validation": { "type": "string", "minLength": 1 },
          "tests": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
